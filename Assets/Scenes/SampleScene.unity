  lines:
  - speaker: "\uC80A\uC740\uCD0C\uC7A5"
    text: "\uC911\uAD6D \uCD5C\uCD08\uC758 \uC808\uC740?"
  - speaker: "\uB098"
    text: "\uBAA8\uB974\uACA0\uC5B4\uC694."
  - speaker: "\uC80A\uC740\uCD0C\uC7A5"
    text: "\uADF8\uB7FC \uB098\uB3C4 \uC54C\uB824\uC904 \uC218 \uC5C6\uB124."
  - speaker: "\uB098"
    text: "\uB124?"
  - speaker: "\uC80A\uC740\uCD0C\uC7A5"
    text: "\uC815\uB2F5\uC740 \uB9C8\uC744 \uBCC0\uB450\uB9AC, \uC6B0\uBB3C \uC548\uC744
