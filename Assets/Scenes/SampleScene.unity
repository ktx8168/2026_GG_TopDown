  lines:
  - speaker: "\uB098"
    text: "\uB204\uAD6C\uC2E0\uB370 \uC800\uD76C \uC9D1 \uB4B7\uB730\uC5D0 \uC11C
      \uACC4\uC138\uC694?"
  - speaker: "\uC8FD\uC740 \uAD11\uBD80\uC758 \uC601\uD63C"
    text: "\uC790\uB124.. \uB0B4\uAC00 \uBCF4\uC774\uB098?"
  - speaker: "\uB098"
    text: "\uC798\uB9CC \uBCF4\uC774\uB294\uB370\uC694?"
  - speaker: "\uC8FD\uC740 \uAD11\uBD80\uC758 \uC601\uD63C"
    text: "\uB4DC\uB514\uC5B4 \uC801\uC784\uC790\uAC00 \uB098\uD0C0\uB0AC\uAD6C\uB9CC
      \uADF8\uB798!"
  - speaker: "\uC8FD\uC740 \uAD11\uBD80\uC758 \uC601\uD63C"
    text: "\uB354\uC774\uC0C1 \uBB3B\uC9C0\uB9D0\uACE0, \uC774 \uC5F4\uC1E0\uB97C
      \uBC1B\uC544\uAC00\uAC8C\uB098!"
  - speaker: "\uB098"
    text: "\uBB34\uC2A8 \uC801\uC784\uC790\uC694?"
  choice1: "\uC5E5? \uAC10\uC0AC\uD569\uB2C8\uB2E4??"
  choice2: "\uBD80\uC815\uD0C0\uACA0\uC5B4! \uC2EB\uC5B4\uC694!"
  onChoice1:
    m_PersistentCalls:
