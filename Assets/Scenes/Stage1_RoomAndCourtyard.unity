  m_Script: {fileID: 11500000, guid: 78713542493bcfa4b83f4bb4ab2c50b9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uB2F9\uC9C1 \uC81C\uC790"
    text: "\uB2A6\uC740 \uC2DC\uAC04\uC5D0 \uC5B4\uB51C \uAC00\uB824\uB294 \uAC83\uC774\uB0D0?
      \uBC14\uAE65 \uC0C1\uD669\uC774 \uC88B\uC9C0 \uC54A\uC73C\uB2C8 \uB3CC\uC544\uAC00\uB77C."
  - speaker: "\uB098"
    text: "\uC0AC\uACF5 \uC0AC\uD615\uC774 \uC0B0 \uC544\uB798\uB85C \uB0B4\uB824\uAC00\uC168\uB2E4\uB294\uB370,
      \uC544\uC9C1 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC73C\uC168\uC2B5\uB2C8\uB2E4."
  - speaker: "\uB2F9\uC9C1 \uC81C\uC790"
    text: "\uADF8\uB7FC \uB9C8\uC744\uAE4C\uC9C0\uB294 \uAC00\uC9C0 \uB9D0\uC544\uB77C.
      \uBD84\uC704\uAE30\uAC00 \uC2EC\uC0C1\uCE58 \uC54A\uB354\uAD70."
  - speaker: "\uB098"
    text: "\uC608, \uC0AC\uD615\uAED8 \uAC10\uC0AC\uB4DC\uB9BD\uB2C8\uB2E4!"
  - speaker: "\uB2F9\uC9C1 \uC81C\uC790"
    text: "\uC624\uB0D0, \uBB34\uC2A8 \uC77C\uC774 \uC788\uAC70\uB4E0 \uD63C\uC790
      \uB098\uC11C\uC9C0 \uB9D0\uACE0 \uB3CC\uC544\uC640 \uC54C\uB824\uB77C."
  documentImage: {fileID: 0}
  choice1: 
  choice2: 
