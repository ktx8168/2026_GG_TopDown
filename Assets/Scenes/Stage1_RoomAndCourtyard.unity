  m_Script: {fileID: 11500000, guid: 78713542493bcfa4b83f4bb4ab2c50b9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uB098"
    text: "\uC0AC\uACF5 \uC0AC\uD615\uC774 \uB098\uAC00\uAE30 \uC804\uC5D0 \uC5B4\uB514
      \uACC4\uC168\uB294\uC9C0 \uC544\uC2ED\uB2C8\uAE4C?"
  - speaker: "\uB0A8\uAD81\uD0DD\uB9BC"
    text: "\uC624\uD6C4\uC5D0\uB294 \uBE44\uACB0 \uBCF4\uAD00\uC2E4\uC5D0 \uACC4\uC168\uB2E4.
      \uB0B4\uAC00 \uC11C\uCC45\uC744 \uB3CC\uB824\uB4DC\uB9AC\uB7EC \uAC14\uC744
      \uB54C \uB9C8\uC8FC\uCCE4\uC5B4."
  - speaker: "\uB098"
    text: "\uBCF4\uAD00\uC2E4\uC5D0\uB294 \uBB34\uC2A8 \uC77C\uB85C\u2026\u2026."
  - speaker: "\uB0A8\uAD81\uD0DD\uB9BC"
    text: "\uC6D0\uB798 \uBD09\uC778 \uAE30\uB85D\uC744 \uC0B4\uD53C\uC2DC\uACE4
      \uD588\uC796\uC544. \uCD9C\uC785\uC744 \uD5C8\uB77D\uBC1B\uC740 \uBD84\uC774\uB2C8
      \uC774\uC0C1\uD558\uAC8C \uC5EC\uAE30\uC9C0\uB294 \uC54A\uC558\uB2E4."
  documentImage: {fileID: 0}
  choice1: 
  choice2: 
  onChoice1:
