--- !u!114 &435217686
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 435217683}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 78713542493bcfa4b83f4bb4ab2c50b9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uC81C\uC790 1"
    text: "\uC7A5\uCC9C! \uC774\uC81C \uC77C\uC5B4\uB09C \uAC70\uC57C? \uC704\uC5D0\uC11C\uB294
      \uC544\uBB34 \uC18C\uB9AC\uB3C4 \uBABB \uB4E4\uC5C8\uC5B4?"
  - speaker: "\uB098"
    text: "\uC65C \uC774\uB807\uAC8C \uC18C\uB780\uC774\uC57C?"
  - speaker: "\uC81C\uC790 2"
    text: "\uC9C4\uB839\uBE44\uACB0\uC774 \uC5C6\uC5B4\uC84C\uB2E4. \uC800\uB141
      \uC810\uAC80 \uB54C \uBCF4\uAD00\uD568\uC774 \uBE44\uC5B4 \uC788\uC5C8\uB2E4\uB354\uAD70."
  - speaker: "\uB098"
    text: "\uC5C6\uC5B4\uC84C\uB2E4\uACE0? \uB204\uAC00 \uAC00\uC838\uAC04 \uAC8C
      \uC544\uB2C8\uB77C?"
  - speaker: "\uC81C\uC790 1"
    text: "\uD5C8\uB77D\uBC1B\uACE0 \uAC00\uC838\uAC04 \uC0AC\uB78C\uC740 \uC5C6\uB2E4\uB354\uB77C.
      \uB2F9\uC9C1 \uC0AC\uD615\uC774 \uBCC4\uC6D0 \uC548\uC5D0 \uC788\uB294 \uC81C\uC790\uB4E4\uBD80\uD130
      \uD655\uC778\uD558\uACE0 \uACC4\uC154."
  - speaker: "\uB098"
    text: "\u2026\uC0AC\uACF5 \uC0AC\uD615\uC740? \uB3CC\uC544\uC624\uC168\uC5B4?"
  - speaker: "\uC81C\uC790 2"
    text: "\uC544\uC9C1 \uBABB \uBD24\uB2E4. \uB108\uC640 \uD568\uAED8 \uC788\uB294
      \uC904 \uC54C\uC558\uB294\uB370."
  - speaker: "\uB098"
    text: "\uD574 \uC9C0\uAE30 \uC804\uC5D0\uB294 \uB3CC\uC544\uC628\uB2E4\uACE0
      \uD588\uB294\uB370\u2026\u2026."
  - speaker: "\uC81C\uC790 1"
    text: "\uBB38 \uC9C0\uD0A4\uB358 \uB140\uC11D\uC5D0\uAC8C \uBB3C\uC5B4\uBD10.
      \uB098\uAC00\uC2E4 \uB54C \uBD24\uC744\uC9C0\uB3C4 \uBAA8\uB974\uB2C8."
  documentImage: {fileID: 0}
  choice1: 
  choice2: 
  onChoice1:
    m_PersistentCalls:
      m_Calls: []
  onChoice2:
    m_PersistentCalls:
      m_Calls: []
  onFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 199753452}
