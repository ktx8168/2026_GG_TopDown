--- !u!114 &387680737
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 387680734}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 78713542493bcfa4b83f4bb4ab2c50b9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uB098"
    text: "\uD639\uC2DC \uC6B0\uB9AC \uBA85 \uD615\uC744 \uBCF4\uC168\uC2B5\uB2C8\uAE4C?"
  - speaker: "\uB0A8\uAD81\uC704"
    text: "\uC0AC\uACF5\uBA85? \uD574\uAC00 \uC0B0\uB9C8\uB8E8\uC5D0 \uAC78\uB9B4
      \uBB34\uB835 \uB098\uAC00\uB354\uAD70. \uB9C8\uC744\uB85C \uB0B4\uB824\uAC00\uB294
      \uAE38\uC774\uC5C8\uB2E4."
  - speaker: "\uB098"
    text: "\uB204\uAD6C\uC640 \uD568\uAED8 \uAC00\uC168\uC2B5\uB2C8\uAE4C?"
  - speaker: "\uB0A8\uAD81\uC704"
    text: "\uD63C\uC790\uC600\uB2E4. \uBD88\uB800\uB354\uB2C8 \uC190\uB9CC \uB4E4\uC5B4
      \uBCF4\uC774\uB354\uB77C\uACE0. \uD3C9\uC18C \uAC19\uC73C\uBA74 \uD55C\uB9C8\uB514\uCBE4
      \uBC1B\uC544\uC8FC\uC5C8\uC744 \uD150\uB370."
  documentImage: {fileID: 0}
  choice1: 
  choice2: 
  onChoice1:
    m_PersistentCalls:
      m_Calls: []
  onChoice2:
    m_PersistentCalls:
      m_Calls: []
  onFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 199753452}
